{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engrams.md/schema/engrams.schema.json",
  "title": "ENGRAMS.md cartridge declaration (v0.1)",
  "type": "object",
  "required": ["name", "version", "base_model", "query_shapes", "facts", "files"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "publisher": {"type": "string"},
    "license": {"type": "string"},
    "source": {"type": "string"},
    "base_model": {
      "type": "object",
      "required": ["id", "fingerprint"],
      "properties": {
        "id": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{12,64}$"},
        "tokenizer_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{12,64}$"}
      }
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": {"type": "string", "enum": ["lora"]},
          "name": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "injection_layer": {"type": "integer", "minimum": 0},
    "keys": {
      "type": "object",
      "properties": {
        "orders": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "heads": {"type": "integer", "minimum": 1},
        "buckets": {"type": "integer", "minimum": 2},
        "dim": {"type": "integer", "minimum": 1}
      }
    },
    "query_shapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format"],
        "properties": {
          "format": {"type": "string"},
          "example": {"type": "string"},
          "value": {"type": "string"}
        }
      }
    },
    "facts": {"type": "integer", "minimum": 1},
    "audit": {
      "type": "object",
      "required": ["method", "accuracy", "correct", "total"],
      "properties": {
        "method": {"type": "string"},
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "correct": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "misses": {"type": "string"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sha256", "format"],
        "properties": {
          "url": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "format": {"type": "string", "enum": ["engram-gguf/1"]}
        },
        "anyOf": [{"required": ["url"]}, {"required": ["path"]}]
      }
    },
    "security": {
      "type": "object",
      "properties": {"profile": {"type": "string", "enum": ["public", "pseudonymous"]}}
    },
    "adapter_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16,64}$"}
  }
}
